# Flag de ambiente: 'devel' (para container docker/IP local) ou 'prod' (para Render)
EXPO_PUBLIC_ENV=devel

# Informe o IP local da sua máquina na rede (ex: 192.168.x.x) para modo 'devel'
# Descubra seu IP no Linux/Mac com `hostname -I` ou no Windows com `ipconfig`
EXPO_PUBLIC_IP=

# URL do Render para modo 'prod' (usado quando EXPO_PUBLIC_ENV=prod)
EXPO_PUBLIC_API_URL=https://rotacricmobile.onrender.com/api
