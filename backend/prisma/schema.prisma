generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model City {
  id           BigInt   @id @default(autoincrement())
  name         String   @db.VarChar(255)
  banner_image String   @db.VarChar(100)
  latitude     Decimal  @db.Decimal(9, 6)
  longitude    Decimal  @db.Decimal(9, 6)
  active       Boolean  @db.TinyInt
  visible      Boolean  @db.TinyInt
  zoom         Int
  created_at   DateTime @db.DateTime(6)
  updated_at   DateTime @db.DateTime(6)

  city_images   CityImage[]
  city_routes   CityRoute[]
  anchor_points AnchorPoint[]

  @@map("city")
}

model CityImage {
  id         BigInt  @id @default(autoincrement())
  image_path String  @db.VarChar(100)
  title      String? @db.VarChar(255)
  subtitle   String? @db.VarChar(255)
  city_id    BigInt

  city City @relation(fields: [city_id], references: [id])

  @@map("city_image")
}

model Route {
  id                 BigInt   @id @default(autoincrement())
  external_strava_id String?  @unique(map: "external_strava_id") @db.VarChar(50)
  name               String?  @db.VarChar(255)
  polyline           String?  @db.LongText
  color              String   @db.VarChar(18)
  distance           String?  @db.VarChar(500)
  active             Boolean  @db.TinyInt
  is_event_route     Boolean  @db.TinyInt

  city_routes CityRoute[]

  @@map("route")
}

model CityRoute {
  id       BigInt @id @default(autoincrement())
  city_id  BigInt
  route_id BigInt

  city  City  @relation(fields: [city_id], references: [id])
  route Route @relation(fields: [route_id], references: [id])

  @@unique([city_id, route_id], map: "city_route_city_id_route_id_0d0cd56f_uniq")
  @@map("city_route")
}

model AnchorPointCategory {
  id         BigInt   @id @default(autoincrement())
  name       String   @db.VarChar(100)
  icon_name  String   @unique(map: "icon_name") @db.VarChar(100)
  is_active  Boolean  @db.TinyInt
  created_at DateTime @db.DateTime(6)
  updated_at DateTime @db.DateTime(6)

  anchor_points AnchorPoint[]

  @@map("anchorpoint_category")
}

model AnchorPoint {
  id                      BigInt   @id @default(autoincrement())
  name                    String?  @db.VarChar(255)
  latitude                Decimal? @db.Decimal(9, 6)
  longitude               Decimal? @db.Decimal(9, 6)
  business_hours          String?  @db.VarChar(120)
  phone                   String?  @db.VarChar(30)
  image                   String   @db.VarChar(100)
  address                 String?  @db.VarChar(255)
  is_event_anchorpoint    Boolean  @db.TinyInt
  active                  Boolean  @db.TinyInt
  anchorpoint_category_id BigInt
  city_id                 BigInt?

  category AnchorPointCategory @relation(fields: [anchorpoint_category_id], references: [id])
  city     City?               @relation(fields: [city_id], references: [id])

  @@map("anchorpoint")
}

model AuthUser {
  id           Int       @id @default(autoincrement())
  password     String    @db.VarChar(128)
  last_login   DateTime? @db.DateTime(6)
  is_superuser Boolean   @db.TinyInt
  username     String    @unique(map: "username") @db.VarChar(150)
  first_name   String    @db.VarChar(150)
  last_name    String    @db.VarChar(150)
  email        String    @db.VarChar(254)
  is_staff     Boolean   @db.TinyInt
  is_active    Boolean   @db.TinyInt
  date_joined  DateTime  @db.DateTime(6)

  profile UserProfile?

  @@map("auth_user")
}

model UserProfile {
  user_id              Int       @id
  birth_date           DateTime? @db.Date
  document             String?   @db.VarChar(20)
  document_type        String?   @db.VarChar(3)
  social_network       String?   @db.VarChar(255)
  social_network_type  String?   @db.VarChar(12)
  profile_picture_path String?   @db.VarChar(100)
  created_at           DateTime  @db.DateTime(6)
  updated_at           DateTime  @db.DateTime(6)

  user AuthUser @relation(fields: [user_id], references: [id])

  @@map("user_profile")
}